# URL de la pasarela (proxy del LLM) que la app consultará en el futuro.
# Todavía no se usa: el motor local es la fuente de verdad por defecto.
# Las variables EXPO_PUBLIC_* quedan expuestas al cliente, así que aquí nunca
# va ninguna clave de API: solo la URL pública del proxy.
EXPO_PUBLIC_API_URL=
