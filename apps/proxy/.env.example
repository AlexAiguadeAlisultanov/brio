# Clave de la Claude API. Vive SOLO aquí, nunca en la app ni en el repositorio.
# Sin clave, el proxy responde 503 {fallback:true} y la app usa su motor local.
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto claude-opus-5-5. Para esta tarea (elegir entre
# candidatos ya válidos) claude-haiku-5-5 es mucho más barato y suficiente;
# cámbialo si quieres abaratar la demo.
MODELO_LLM=claude-opus-5-5

# Origen permitido para CORS (la URL de la app/demo). Varios separados por comas.
ORIGEN_PERMITIDO=http://localhost:8081

# Puerto. Render inyecta PORT.
PORT=8099

# Cortafuegos de coste: tope global de peticiones al LLM por día. Al superarse,
# el proxy responde 503 {fallback:true} y la app sigue con su motor local.
TOPE_PETICIONES_DIA=500
