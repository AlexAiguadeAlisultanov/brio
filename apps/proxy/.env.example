# ---------------------------------------------------------------------------
# Backend de Brío. Copia este fichero a .env y rellena lo que uses. El .env real
# NO se sube al repositorio (está en .gitignore). Las claves reales las pones tú.
# ---------------------------------------------------------------------------

# --- IA (Claude) -----------------------------------------------------------
# Clave de la Claude API. Vive SOLO aquí, nunca en la app ni en el repositorio.
# Sin clave, /api/adaptar responde 503 {fallback:true} y la app usa su motor local.
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto claude-opus-5-5. Para esta tarea (elegir entre
# candidatos ya válidos) claude-haiku-5-5 es mucho más barato y suficiente.
MODELO_LLM=claude-opus-5-5

# Cortafuegos de coste: tope global de peticiones al LLM por día.
TOPE_PETICIONES_DIA=500

# --- Base de datos ---------------------------------------------------------
# Ruta del fichero SQLite (node:sqlite, sin dependencias nativas). La carpeta se
# crea sola. Por defecto ./datos/brio.db.
#
# OJO EN PRODUCCIÓN: en Render el disco es EFÍMERO y se borra en cada despliegue,
# así que una base SQLite en fichero pierde las cuentas al redesplegar. Para
# producción conviene una base persistente (Turso o Postgres). Para la demo,
# SQLite en fichero es suficiente.
DB_PATH=./datos/brio.db

# Secreto para firmar/derivar los tokens de sesión (se guardan hasheados en la
# base). Pon una cadena larga y aleatoria. Si cambia, caducan todas las sesiones.
TOKEN_SECRETO=

# Días que dura una sesión antes de caducar.
DIAS_SESION=30

# --- Pagos (Stripe) --------------------------------------------------------
# Clave secreta de Stripe. En modo pruebas empieza por sk_test_. Vive SOLO en el
# servidor. Sin ella, /api/pago/checkout responde 503 {sinPago:true} y la demo
# sigue funcionando sin cobros.
STRIPE_SECRET_KEY=

# Secreto del endpoint de webhook (empieza por whsec_). Lo da Stripe al dar de
# alta el webhook. Sin él, /api/pago/webhook responde 503.
STRIPE_WEBHOOK_SECRET=

# Opcional: id de un precio de Stripe ya creado para la suscripción mensual
# (empieza por price_). Si lo pones, se usa en lugar de construir el precio.
STRIPE_PRICE_ID=

# Precio en céntimos (499 = 4,99 €) y moneda. Se usan si no hay STRIPE_PRICE_ID.
PRECIO_CENTIMOS=499
MONEDA=eur

# A dónde vuelve el navegador tras pagar o cancelar en Stripe Checkout.
URL_EXITO=https://example.com/pago/ok
URL_CANCELAR=https://example.com/pago/cancelado

# --- Red -------------------------------------------------------------------
# Origen permitido para CORS (la URL de la app/demo). Varios separados por comas.
ORIGEN_PERMITIDO=http://localhost:8081

# Puerto. Render inyecta PORT.
PORT=8099

# Límites de peticiones por minuto (API general) y por 15 min (registro/acceso).
LIMITE_API=60
LIMITE_AUTH=10
